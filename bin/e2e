#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

COMPOSE="docker compose -f docker/compose.e2e.yaml"
CONTEXT_FILE="tests/E2E/.context.json"

# Never committed: a fresh key per run, so no application key lives in the repository.
export E2E_APP_KEY="base64:$(openssl rand -base64 32)"

# A typo here (e.g. --upstrem) used to be silently ignored: the run would proceed as the
# default suite and still print "e2e: green" at the end, with nobody having noticed the
# upstream tests never ran. Any argument this script does not recognize is a hard error
# instead of quietly falling through — including a second or third one, which used to pass
# straight through unchecked (e.g. `bin/e2e --upstream junk` ran the full stack and still
# printed "e2e: green"). Looping over "$@" rather than the old two-position case statement
# is what lets --upstream and --large-layer combine in either order
# (`bin/e2e --upstream --large-layer`), instead of only ever accepting one flag in the
# first position and rejecting a second one outright.
usage() {
    echo "usage: bin/e2e [--upstream] [--large-layer]" >&2
}

for arg in "$@"; do
    case "$arg" in
        --upstream)
            export E2E_UPSTREAM=1
            echo "e2e: upstream tests enabled"
            ;;
        --large-layer)
            export E2E_LARGE_LAYER=1
            echo "e2e: large-layer gate enabled (builds, pushes and pulls a >500 MiB layer)"
            ;;
        *)
            echo "e2e: unrecognized argument '${arg}'" >&2
            usage
            exit 1
            ;;
    esac
done

dump_logs() {
    echo "----- app + worker logs -----" >&2
    $COMPOSE logs --no-color app worker >&2 || true
}

teardown() {
    $COMPOSE down -v --remove-orphans >/dev/null 2>&1 || true
    rm -f "$CONTEXT_FILE"
}

fail() {
    dump_logs
    teardown
    exit 1
}

trap fail ERR

# `docker compose build` takes no cache-from/cache-to flags, so it cannot use a
# layer cache. CI builds the image itself with docker/build-push-action (which
# does accept those flags) and tags it exactly `kontorfix-e2e:local` — the tag
# the `app` service's `image:` already names — then sets E2E_SKIP_BUILD=1 so this
# script does not immediately rebuild over it. Locally, the default stays
# "always build": nobody has to know this variable exists to get a correct run.
if [ "${E2E_SKIP_BUILD:-}" = "1" ]; then
    if ! docker image inspect kontorfix-e2e:local >/dev/null 2>&1; then
        # Not a job for fail(): nothing has started yet, so there are no
        # containers to log or tear down, and exit (unlike a failing command)
        # does not run the ERR trap anyway — see the CONTEXT_FILE check below.
        echo "e2e: E2E_SKIP_BUILD=1 but image 'kontorfix-e2e:local' does not exist" >&2
        echo "e2e: build it first, e.g.:" >&2
        echo "  docker buildx build --load -t kontorfix-e2e:local -f docker/Dockerfile ." >&2
        exit 1
    fi
    echo "e2e: E2E_SKIP_BUILD=1, using existing kontorfix-e2e:local image"
else
    $COMPOSE build
fi

$COMPOSE up -d --wait

# The app container migrates on start (docker/entrypoint.sh). Seeding is ours.
$COMPOSE exec -T app php artisan db:seed --class=E2eSeeder --force \
    | sed -n 's/^E2E_CONTEXT=//p' > "$CONTEXT_FILE"

# A bare `exit 1` on the right side of `||` does not fire `trap ... ERR` in bash,
# even under set -e — so this must call fail() explicitly, not exit directly.
if ! test -s "$CONTEXT_FILE"; then
    echo "e2e: seeder produced no context" >&2
    fail
fi

vendor/bin/pest -c phpunit.e2e.xml

trap - ERR
teardown
echo "e2e: green"
